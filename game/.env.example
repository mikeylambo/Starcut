# Client build config (Vercel project env vars). Only PUBLIC values belong here —
# everything below ends up in the browser bundle.
# Authority server (TLS-fronted signalling), e.g. https://authority.example.com
VITE_AUTHORITY_URL=
# Optional Supabase sign-in (Discord OAuth + email magic link): project URL + ANON key only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
