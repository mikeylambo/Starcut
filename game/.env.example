# Client build-time config (Vite). Copy to game/.env.production.local, or set in Vercel.
# Where the authority lives. https + no port = 443 (behind a TLS proxy, see DEPLOY.md).
VITE_AUTHORITY_URL=https://authority.example.com
# STUN for the browser's WebRTC leg (comma-separated).
VITE_STUN_URLS=stun:stun.l.google.com:19302
# TURN slot (not needed yet).
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USER=
# VITE_TURN_PASS=
