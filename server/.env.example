# Authority runtime config (docker run --env-file server/.env ...).
PORT=9208
RTC_PORT_MIN=20000
RTC_PORT_MAX=20010
STARCUT_DATA=/data
# Restrict signalling CORS to your client origin once it is deployed.
CORS_ORIGIN=*
# STUN lets the server advertise its public IP behind cloud 1:1 NAT (comma-separated).
STUN_URLS=stun:stun.l.google.com:19302
# NO_STUN=1            # LAN only
# TURN slot (later):
# TURN_URL=turn:turn.example.com:3478
# TURN_USER=
# TURN_PASS=
# Lag harness (testing only): STARCUT_LINK=typical  or  STARCUT_LAG=150 STARCUT_JITTER=25 STARCUT_LOSS=2

# ---- v5 beta services -------------------------------------------------------------
# Admin page at /admin (feedback inbox, report queue, dashboards). Unset = admin disabled.
ADMIN_PASSWORD=
# Where the game client lives (admin replay links open it with ?replay=ID).
CLIENT_URL=https://starcut.vercel.app
# Optional Supabase (profiles, faction war, feedback, reports, telemetry). Unset = JSON
# files under STARCUT_DATA. The SERVICE ROLE key stays on this server only.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=          # used only to verify player sign-in tokens
